-- helper image support (rbxassetid & custom url)
local function GetImage(urlOrId)
    if not urlOrId or urlOrId == "" then return "" end
    if string.find(urlOrId, "rbxassetid://") or string.find(urlOrId, "http") == nil then
        return urlOrId
    end
    -- Support HTTP URL for executors that support custom asset loading
    if getcustomasset then
        local success, asset = pcall(function()
            local fileName = "custom_asset_" .. tick() .. ".png"
            if writefile and request then
                local req = request({Url = urlOrId, Method = "GET"})
                writefile(fileName, req.Body)
                return getcustomasset(fileName)
            end
        end)
        if success and asset then return asset end
    end
    return urlOrId
end

