function ShowLoading(title, text, duration)
  local LoadingFrame = Create("Frame", ScreenGui, {
    Size = UDim2.new(0, 300, 0, 150),
    Position = UDim2.new(0.5, -150, 0.5, -75),
    BackgroundColor3 = Configs_HUB.Cor_Hub,
    BackgroundTransparency = 0.1
  })Corner(LoadingFrame)Stroke(LoadingFrame)

  local LoadingTitle = Create("TextLabel", LoadingFrame, {
    Size = UDim2.new(1, 0, 0, 40),
    Text = title or "Loading...",
    TextColor3 = Configs_HUB.Cor_Text,
    Font = Configs_HUB.Text_Font,
    TextSize = 22,
    BackgroundTransparency = 1
  })

  local BarBackground = Create("Frame", LoadingFrame, {
    Size = UDim2.new(0.8, 0, 0, 10),
    Position = UDim2.new(0.1, 0, 0.6, 0),
    BackgroundColor3 = Configs_HUB.Cor_Options
  })Corner(BarBackground)

  local BarFill = Create("Frame", BarBackground, {
    Size = UDim2.new(0, 0, 1, 0),
    BackgroundColor3 = Configs_HUB.Cor_Stroke
  })Corner(BarFill)

  CreateTween(BarFill, "Size", UDim2.new(1, 0, 1, 0), duration or 2, true)
  LoadingFrame:Destroy()
end

