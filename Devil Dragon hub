--[[
    AXL LIBRARY | Roblox Studio UI Library
    Safe LocalScript UI framework. Put this ModuleScript in ReplicatedStorage.
    Supported image formats: rbxassetid://123456789 and https://... (Roblox must permit the asset).
]]

local AXL = {}
AXL.__index = AXL

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local function New(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function Corner(parent, radius)
    return New("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, parent)
end

local function Stroke(parent, color, thickness, transparency)
    return New("UIStroke", {Color = color, Thickness = thickness or 1, Transparency = transparency or 0}, parent)
end

local function Tween(obj, props, duration, style)
    local info = TweenInfo.new(duration or .18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props); t:Play(); return t
end

local function ImageId(value)
    if not value or value == "" then return "" end
    value = tostring(value)
    if value:match("^%d+$") then return "rbxassetid://" .. value end
    return value
end

local function MakeDraggable(handle, target)
    local dragging, start, origin
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; start = input.Position; origin = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - start
            target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X, origin.Y.Scale, origin.Y.Offset + delta.Y)
        end
    end)
end

function AXL.new(options)
    options = options or {}
    local self = setmetatable({}, AXL)
    self.Theme = {
        Background = options.Background or Color3.fromRGB(10, 10, 14),
        Panel = options.Panel or Color3.fromRGB(18, 18, 25),
        Panel2 = options.Panel2 or Color3.fromRGB(25, 25, 34),
        Accent = options.Accent or Color3.fromRGB(155, 80, 255),
        Accent2 = options.Accent2 or Color3.fromRGB(91, 45, 155),
        Text = options.Text or Color3.fromRGB(245, 242, 250),
        Muted = options.Muted or Color3.fromRGB(160, 155, 175),
        Good = Color3.fromRGB(70, 210, 130),
        Bad = Color3.fromRGB(235, 80, 100),
    }
    self.Title = options.Title or "FREE LIBRARY HUB"
    self.Size = options.Size or UDim2.fromOffset(720, 480)
    self.Tabs = {}; self.Connections = {}; self.Minimized = false
    self:_build(options)
    return self
end

function AXL:_build(options)
    local parent = options.Parent or (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")
    self.Gui = New("ScreenGui", {Name = "AXL_LIBRARY", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, parent)
    self.Main = New("Frame", {Name="Window", Size=self.Size, Position=UDim2.fromScale(.5,.5), AnchorPoint=Vector2.new(.5,.5), BackgroundColor3=self.Theme.Background, BorderSizePixel=0}, self.Gui)
    Corner(self.Main, options.Roundness or 14); Stroke(self.Main, self.Theme.Accent, 1.5)
    self.Scale = New("UIScale", {Scale=options.Scale or 1}, self.Main)
    self.BackgroundImage = New("ImageLabel", {Name="BackgroundImage", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Image=ImageId(options.BackgroundImage), ImageTransparency=options.BackgroundImageTransparency or .82, ScaleType=Enum.ScaleType.Crop, ZIndex=0}, self.Main)
    Corner(self.BackgroundImage, options.Roundness or 14)
    self.Top = New("Frame", {Size=UDim2.new(1,0,0,54), BackgroundColor3=self.Theme.Panel, BackgroundTransparency=.12, BorderSizePixel=0, ZIndex=2}, self.Main)
    Corner(self.Top, 14)
    New("TextLabel", {Size=UDim2.new(1,-120,1,0), Position=UDim2.fromOffset(18,0), BackgroundTransparency=1, Text=self.Title, TextColor3=self.Theme.Text, TextSize=19, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3}, self.Top)
    local min = New("TextButton", {Size=UDim2.fromOffset(34,30), Position=UDim2.new(1,-78,0,12), BackgroundColor3=self.Theme.Panel2, Text="−", TextColor3=self.Theme.Text, TextSize=22, Font=Enum.Font.GothamBold, AutoButtonColor=false, ZIndex=3}, self.Top); Corner(min,8)
    local close = New("TextButton", {Size=UDim2.fromOffset(34,30), Position=UDim2.new(1,-38,0,12), BackgroundColor3=self.Theme.Bad, BackgroundTransparency=.15, Text="×", TextColor3=self.Theme.Text, TextSize=21, Font=Enum.Font.GothamBold, AutoButtonColor=false, ZIndex=3}, self.Top); Corner(close,8)
    min.MouseEnter:Connect(function() Tween(min,{BackgroundColor3=self.Theme.Accent},.12) end); min.MouseLeave:Connect(function() Tween(min,{BackgroundColor3=self.Theme.Panel2},.12) end)
    min.MouseButton1Click:Connect(function() self:SetMinimized(not self.Minimized) end)
    close.MouseButton1Click:Connect(function() self:Destroy() end)
    MakeDraggable(self.Top, self.Main)
    self.Side = New("ScrollingFrame", {Size=UDim2.new(0,170,1,-70), Position=UDim2.fromOffset(10,62), BackgroundColor3=self.Theme.Panel, BackgroundTransparency=.1, BorderSizePixel=0, ScrollBarThickness=3, ScrollBarImageColor3=self.Theme.Accent, CanvasSize=UDim2.new(), ZIndex=2}, self.Main); Corner(self.Side,10)
    New("UIListLayout", {Padding=UDim.new(0,7), SortOrder=Enum.SortOrder.LayoutOrder}, self.Side)
    New("UIPadding", {PaddingTop=UDim.new(0,10), PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8)}, self.Side)
    self.Content = New("Frame", {Size=UDim2.new(1,-190,1,-70), Position=UDim2.fromOffset(180,62), BackgroundTransparency=1, ZIndex=2}, self.Main)
    self.Toast = New("TextLabel", {Size=UDim2.fromOffset(260,38), Position=UDim2.new(1,-275,1,-50), BackgroundColor3=self.Theme.Panel2, TextColor3=self.Theme.Text, TextSize=13, Font=Enum.Font.GothamMedium, Visible=false, ZIndex=20}, self.Main); Corner(self.Toast,8); Stroke(self.Toast,self.Theme.Accent,1)
    local open = New("TextButton", {Name="OpenButton", Size=UDim2.fromOffset(48,48), Position=UDim2.fromOffset(20,180), BackgroundColor3=self.Theme.Accent2, Text="+", TextColor3=self.Theme.Text, TextSize=28, Font=Enum.Font.GothamBold, Visible=false, AutoButtonColor=false, ZIndex=10}, self.Gui); Corner(open,24); Stroke(open,self.Theme.Accent,1.5); MakeDraggable(open,open)
    open.MouseButton1Click:Connect(function() self:SetMinimized(false) end); self.OpenButton=open
end

function AXL:SetMinimized(value)
    self.Minimized=value
    if value then
        Tween(self.Main,{Size=UDim2.fromOffset(0,0)},.25); task.wait(.25); self.Main.Visible=false; self.OpenButton.Visible=true
    else
        self.OpenButton.Visible=false; self.Main.Visible=true; self.Main.Size=UDim2.fromOffset(0,0); Tween(self.Main,{Size=self.Size},.25)
    end
end
function AXL:Destroy() if self.Gui then self.Gui:Destroy() end end
function AXL:Notify(text, duration)
    self.Toast.Text=tostring(text); self.Toast.Visible=true; self.Toast.TextTransparency=1; Tween(self.Toast,{TextTransparency=0},.15)
    task.delay(duration or 2,function() if self.Toast then Tween(self.Toast,{TextTransparency=1},.2); task.wait(.2); self.Toast.Visible=false end end)
end
function AXL:SetTheme(theme)
    for k,v in pairs(theme or {}) do if self.Theme[k] then self.Theme[k]=v end end
    Stroke(self.Main,self.Theme.Accent,1.5).Color=self.Theme.Accent
end
function AXL:SetBackground(image, transparency) self.BackgroundImage.Image=ImageId(image); self.BackgroundImage.ImageTransparency=transparency or .82 end

function AXL:CreateTab(name, icon)
    local tab={Name=name, Items={}, Visible=false}
    local button=New("TextButton", {Size=UDim2.new(1,0,0,38), BackgroundColor3=self.Theme.Panel2, BackgroundTransparency=1, Text=(icon and icon.."  " or "")..name, TextColor3=self.Theme.Muted, TextSize=13, Font=Enum.Font.GothamSemibold, AutoButtonColor=false, ZIndex=3}, self.Side); Corner(button,8)
    local page=New("ScrollingFrame", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=4, ScrollBarImageColor3=self.Theme.Accent, Visible=false, CanvasSize=UDim2.new(), ZIndex=3}, self.Content)
    New("UIListLayout", {Padding=UDim.new(0,9), SortOrder=Enum.SortOrder.LayoutOrder}, page); New("UIPadding", {PaddingTop=UDim.new(0,3), PaddingLeft=UDim.new(0,5), PaddingRight=UDim.new(0,8), PaddingBottom=UDim.new(0,8)},page)
    page.ChildAdded:Connect(function() task.defer(function() page.CanvasSize=UDim2.fromOffset(0,page.UIListLayout.AbsoluteContentSize.Y+18) end) end)
    tab.Button=button; tab.Page=page; table.insert(self.Tabs,tab)
    button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
    if #self.Tabs==1 then self:SelectTab(tab) end
    return tab
end
function AXL:SelectTab(tab)
    for _,t in ipairs(self.Tabs) do t.Visible=t==tab; t.Page.Visible=t==tab; Tween(t.Button,{BackgroundTransparency=t==tab and .05 or 1, TextColor3=t==tab and self.Theme.Text or self.Theme.Muted},.15) end
end

function AXL:Section(tab, title)
    local f=New("Frame",{Size=UDim2.new(1,0,0,32),BackgroundColor3=self.Theme.Panel2,BackgroundTransparency=.18,BorderSizePixel=0},tab.Page); Corner(f,8); Stroke(f,self.Theme.Accent2,1)
    New("TextLabel",{Size=UDim2.new(1,-18,1,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,Text=title,TextColor3=self.Theme.Accent,TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},f)
    return f
end
function AXL:_row(tab,height)
    local f=New("Frame",{Size=UDim2.new(1,0,0,height or 42),BackgroundColor3=self.Theme.Panel,BackgroundTransparency=.08,BorderSizePixel=0},tab.Page); Corner(f,8); return f
end
function AXL:Label(tab,text,subtext)
    local f=self:_row(tab,subtext and 55 or 36); New("TextLabel",{Size=UDim2.new(1,-18,subtext and 30 or 36,0),Position=UDim2.fromOffset(9,0),BackgroundTransparency=1,Text=text,TextColor3=self.Theme.Text,TextSize=14,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},f)
    if subtext then New("TextLabel",{Size=UDim2.new(1,-18,0,22),Position=UDim2.fromOffset(9,28),BackgroundTransparency=1,Text=subtext,TextColor3=self.Theme.Muted,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},f) end
    return f
end
function AXL:Button(tab,text,callback)
    local f=self:_row(tab,42); local b=New("TextButton",{Size=UDim2.new(1,-16,1,-10),Position=UDim2.fromOffset(8,5),BackgroundColor3=self.Theme.Accent2,Text=text,TextColor3=self.Theme.Text,TextSize=13,Font=Enum.Font.GothamBold,AutoButtonColor=false},f); Corner(b,7)
    b.MouseEnter:Connect(function() Tween(b,{BackgroundColor3=self.Theme.Accent},.12) end); b.MouseLeave:Connect(function() Tween(b,{BackgroundColor3=self.Theme.Accent2},.12) end); b.MouseButton1Click:Connect(function() if callback then callback() end end); return b
end
function AXL:Toggle(tab,text,default,callback)
    local f=self:_row(tab,42); New("TextLabel",{Size=UDim2.new(1,-75,1,0),Position=UDim2.fromOffset(12,0),BackgroundTransparency=1,Text=text,TextColor3=self.Theme.Text,TextSize=13,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},f)
    local b=New("TextButton",{Size=UDim2.fromOffset(48,24),Position=UDim2.new(1,-60,.5,-12),BackgroundColor3=self.Theme.Panel2,Text="",AutoButtonColor=false},f); Corner(b,12); Stroke(b,self.Theme.Accent2,1)
    local knob=New("Frame",{Size=UDim2.fromOffset(18,18),Position=UDim2.fromOffset(3,3),BackgroundColor3=self.Theme.Muted,BorderSizePixel=0},b); Corner(knob,9)
    local state=default==true; local api={}
    local function set(v) state=v==true; Tween(b,{BackgroundColor3=state and self.Theme.Accent or self.Theme.Panel2},.15); Tween(knob,{Position=state and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3),BackgroundColor3=state and Color3.new(1,1,1) or self.Theme.Muted},.15); if callback then callback(state) end end
    function api:Set(v) set(v) end; function api:Get() return state end; b.MouseButton1Click:Connect(function() set(not state) end); set(state); return api
end
function AXL:Slider(tab,text,min,max,default,callback)
    min=min or 0; max=max or 100; default=math.clamp(default or min,min,max); local f=self:_row(tab,58); New("TextLabel",{Size=UDim2.new(1,-90,0,25),Position=UDim2.fromOffset(12,2),BackgroundTransparency=1,Text=text,TextColor3=self.Theme.Text,TextSize=13,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},f)
    local val=New("TextLabel",{Size=UDim2.fromOffset(65,25),Position=UDim2.new(1,-75,0,2),BackgroundTransparency=1,Text=tostring(default),TextColor3=self.Theme.Accent,TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right},f)
    local bar=New("Frame",{Size=UDim2.new(1,-24,0,6),Position=UDim2.fromOffset(12,38),BackgroundColor3=self.Theme.Panel2,BorderSizePixel=0},f); Corner(bar,4); local fill=New("Frame",{Size=UDim2.new((default-min)/(max-min),0,1,0),BackgroundColor3=self.Theme.Accent,BorderSizePixel=0},bar); Corner(fill,4); local knob=New("TextButton",{Size=UDim2.fromOffset(18,18),Position=UDim2.new((default-min)/(max-min),-9,.5,-9),BackgroundColor3=self.Theme.Text,Text="",AutoButtonColor=false},bar); Corner(knob,9)
    local api={}; local value=default; local function set(x) value=math.clamp(math.floor(x+.5),min,max); local p=(value-min)/(max-min); fill.Size=UDim2.new(p,0,1,0); knob.Position=UDim2.new(p,-9,.5,-9); val.Text=tostring(value); if callback then callback(value) end end
    local function input(i) local p=math.clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1); set(min+(max-min)*p) end
    bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then input(i) end end); UserInputService.InputChanged:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then input(i) end end end)
    function api:Set(x) set(x) end; function api:Get() return value end; return api
end
function AXL:Dropdown(tab,text,items,default,callback)
    local f=self:_row(tab,42); local b=New("TextButton",{Size=UDim2.new(1,-16,1,-8),Position=UDim2.fromOffset(8,4),BackgroundColor3=self.Theme.Panel2,Text=text.."  ▾",TextColor3=self.Theme.Text,TextSize=13,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false},f); Corner(b,7); New("UIPadding",{PaddingLeft=UDim.new(0,10)},b)
    local list=New("Frame",{Size=UDim2.new(1,0,0,0),Position=UDim2.new(0,0,1,2),BackgroundColor3=self.Theme.Panel2,Visible=false,ClipsDescendants=true,ZIndex=8},b); Corner(list,7); New("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder},list)
    local api={Value=default}; local function choose(x) api.Value=x; b.Text=text..": "..tostring(x).."  ▾"; list.Visible=false; if callback then callback(x) end end
    for _,x in ipairs(items or {}) do local opt=New("TextButton",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text=tostring(x),TextColor3=self.Theme.Text,TextSize=12,Font=Enum.Font.Gotham,AutoButtonColor=false,ZIndex=9},list); opt.MouseButton1Click:Connect(function() choose(x) end) end
    b.MouseButton1Click:Connect(function() list.Visible=not list.Visible; list.Size=UDim2.new(1,0,0,list.Visible and math.min(#items*28,140) or 0) end); function api:Set(x) choose(x) end; return api
end
function AXL:Textbox(tab,placeholder,default,callback)
    local f=self:_row(tab,42); local box=New("TextBox",{Size=UDim2.new(1,-16,1,-8),Position=UDim2.fromOffset(8,4),BackgroundColor3=self.Theme.Panel2,PlaceholderText=placeholder or "Type here...",Text=default or "",TextColor3=self.Theme.Text,PlaceholderColor3=self.Theme.Muted,TextSize=13,Font=Enum.Font.Gotham,ClearTextOnFocus=false},f); Corner(box,7); New("UIPadding",{PaddingLeft=UDim.new(0,10)},box); box.FocusLost:Connect(function() if callback then callback(box.Text) end end); return box
end
function AXL:Keybind(tab,text,key,callback)
    local f=self:_row(tab,42); local b=New("TextButton",{Size=UDim2.new(1,-16,1,-8),Position=UDim2.fromOffset(8,4),BackgroundColor3=self.Theme.Panel2,Text=text.." ["..key.Name.."]",TextColor3=self.Theme.Text,TextSize=13,Font=Enum.Font.GothamMedium,AutoButtonColor=false},f); Corner(b,7); local listening=false; b.MouseButton1Click:Connect(function() listening=true; b.Text=text.." [press key]" end); local c=UserInputService.InputBegan:Connect(function(i,g) if not g and listening and i.UserInputType==Enum.UserInputType.Keyboard then key=i.KeyCode; listening=false; b.Text=text.." ["..key.Name.."]" elseif not g and i.KeyCode==key and callback then callback() end end); table.insert(self.Connections,c); return b
end
function AXL:Image(tab,image,caption)
    local f=self:_row(tab,caption and 155 or 120); local img=New("ImageLabel",{Size=UDim2.new(1,-20,1,-20),Position=UDim2.fromOffset(10,10),BackgroundColor3=self.Theme.Panel2,Image=ImageId(image),ScaleType=Enum.ScaleType.Crop},f); Corner(img,8); if caption then New("TextLabel",{Size=UDim2.new(1,-20,0,24),Position=UDim2.fromOffset(10,125),BackgroundTransparency=1,Text=caption,TextColor3=self.Theme.Text,TextSize=12,Font=Enum.Font.Gotham},f) end; return img
end
function AXL:Link(tab,name,url)
    return self:Button(tab,name,function() if setclipboard then setclipboard(url); self:Notify("Copied: "..url) else self:Notify("Clipboard is unavailable in this environment") end end)
end
function AXL:Separator(tab)
    local f=self:_row(tab,10); f.BackgroundTransparency=1; New("Frame",{Size=UDim2.new(1,-20,0,1),Position=UDim2.fromOffset(10,4),BackgroundColor3=self.Theme.Accent2,BorderSizePixel=0},f); return f
end
return AXL

