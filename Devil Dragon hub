                Lbl.Text = text
                Lbl.TextColor3 = AXLLibrary.Themes.SubTextColor
                Lbl.TextSize = 12
                Lbl.TextXAlignment = Enum.TextXAlignment.Left
                Lbl.BackgroundTransparency = 1
                Lbl.Parent = SecContainer
            end
            SectionObj.AddLabel = SectionObj.CreateLabel

            return SectionObj
        end

        return TabObj
    end

    return WindowObj
end

return AXLLibrary
