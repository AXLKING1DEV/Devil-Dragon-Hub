                tab.Button.TextColor3 = Color3.fromRGB(150, 150, 150)
                tab.Button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            end
            PageScroll.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        end)

        if #Library.Tabs == 0 then
            PageScroll.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        end

