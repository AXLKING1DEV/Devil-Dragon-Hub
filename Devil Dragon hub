                OptBtn.TextSize = 12
                OptBtn.Parent = OptionHolder

                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 6)
                OptCorner.Parent = OptBtn

                OptBtn.MouseButton1Click:Connect(function()
                    SelectedLabel.Text = opt
                    isExpanded = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 38)}):Play()
                    pcall(Callback, opt)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                local targetHeight = isExpanded and (45 + #Options * 28) or 38
                TweenService:Create(DropFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            end)
        end

        -- 6. Textbox
        function TabElements:AddTextbox(boxConfig)
            local Name = boxConfig.Name or "Textbox"
            local Placeholder = boxConfig.Placeholder or "Enter text..."
            local Callback = boxConfig.Callback or function() end

            local BoxFrame = Instance.new("Frame")
            BoxFrame.Size = UDim2.new(1, 0, 0, 38)
            BoxFrame.BackgroundColor3 = AXLLibrary.Themes.Card
            BoxFrame.Parent = Container

            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 8)
            BoxCorner.Parent = BoxFrame

            local BoxText = Instance.new("TextLabel")
            BoxText.Size = UDim2.new(0.5, 0, 1, 0)
            BoxText.Position = UDim2.new(0, 12, 0, 0)
            BoxText.BackgroundTransparency = 1
            BoxText.Text = Name
            BoxText.TextColor3 = AXLLibrary.Themes.Text
            BoxText.Font = Enum.Font.Gotham
            BoxText.TextSize = 13
            BoxText.TextXAlignment = Enum.TextXAlignment.Left
            BoxText.Parent = BoxFrame

            local Input = Instance.new("TextBox")
            Input.Size = UDim2.new(0.45, 0, 0.7, 0)
            Input.Position = UDim2.new(0.52, 0, 0.15, 0)
            Input.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
            Input.Text = ""
            Input.PlaceholderText = Placeholder
            Input.TextColor3 = CustomAccent
            Input.PlaceholderColor3 = AXLLibrary.Themes.SubText
            Input.Font = Enum.Font.Gotham
            Input.TextSize = 12
            Input.Parent = BoxFrame

            local InputCorner = Instance.new("UICorner")
            InputCorner.CornerRadius = UDim.new(0, 6)
            InputCorner.Parent = Input

            Input.FocusLost:Connect(function(enterPressed)
                pcall(Callback, Input.Text)
            end)
        end

        -- 7. Social Links Button (Telegram, Discord, YouTube)
        function TabElements:AddSocialButton(socialConfig)
            local Type = socialConfig.Type or "Discord" -- Discord / Telegram / YouTube
            local Link = socialConfig.Link or ""
            local IconMap = {
                Discord = "rbxassetid://6031071832",
                Telegram = "rbxassetid://6031071832",
                YouTube = "rbxassetid://6031071832"
            }

            self:AddButton({
                Name = "Copy " .. Type .. " Link",
                Icon = IconMap[Type] or "",
                Callback = function()
                    if setclipboard then
                        setclipboard(Link)
                        game:GetService("StarterGui"):SetCore("SendNotification", {
                            Title = "AXL Library",
                            Text = Type .. " Link copied to clipboard!",
                            Duration = 3
                        })
                    end
                end
            })
        end

        table.insert(WindowObject.Tabs, TabElements)
        return TabElements
    end

    return WindowObject
end

return AXLLibrary
