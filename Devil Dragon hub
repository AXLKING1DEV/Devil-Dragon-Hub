    function Window:CreateTab(Name, IconId)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(1, 0, 0, 35)
        TabBtn.Text = "   " .. Name
        TabBtn.TextColor3 = Library.Theme.Text
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.BackgroundColor3 = Library.Theme.Secondary
        TabBtn.Parent = TabBar
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        if IconId then
            local TabIcon = Instance.new("ImageLabel")
            TabIcon.Size = UDim2.new(0, 20, 0, 20)
            TabIcon.Position = UDim2.new(0, 5, 0.5, -10)
            TabIcon.BackgroundTransparency = 1
            TabIcon.Parent = TabBtn
            SetImage(TabIcon, IconId)
        end

        local Container = Instance.new("ScrollingFrame")
        Container.Size = UDim2.new(1, 0, 1, -35)
        Container.Position = UDim2.new(0, 0, 0, 35)
        Container.BackgroundTransparency = 1
        Container.ScrollBarThickness = 4
        Container.Visible = false
        Container.Parent = ContentContainer

        local Layout = Instance.new("UIListLayout")
        Layout.Parent = Container
        Layout.Padding = UDim.new(0, 6)
        
        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(Window.Tabs) do
                t.Container.Visible = false
            end
            Container.Visible = true
        end)

        -- Elements System
        function Tab:AddButton(Text, IconId, Callback)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 35)
            Btn.Text = Text
            Btn.TextColor3 = Library.Theme.Text
            Btn.BackgroundColor3 = Library.Theme.Secondary
            Btn.Parent = Container
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

            if IconId then
                local BtnIcon = Instance.new("ImageLabel")
                BtnIcon.Size = UDim2.new(0, 20, 0, 20)
                BtnIcon.Position = UDim2.new(0, 10, 0.5, -10)
                BtnIcon.BackgroundTransparency = 1
                BtnIcon.Parent = Btn
                SetImage(BtnIcon, IconId)
            end

            Btn.MouseButton1Click:Connect(function()
                if Callback then Callback() end
            end)
        end

        function Tab:AddToggle(Text, Default, Callback)
            local Tgl = Instance.new("TextButton")
            Tgl.Size = UDim2.new(1, 0, 0, 35)
            Tgl.Text = "  " .. Text .. (Default and " [ON]" or " [OFF]")
            Tgl.TextColor3 = Library.Theme.Text
            Tgl.BackgroundColor3 = Library.Theme.Secondary
            Tgl.Parent = Container
            Instance.new("UICorner", Tgl).CornerRadius = UDim.new(0, 6)

            local State = Default or false
            Tgl.MouseButton1Click:Connect(function()
                State = not State
                Tgl.Text = "  " .. Text .. (State and " [ON]" or " [OFF]")
                if Callback then Callback(State) end
            end)
        end

        function Tab:AddSlider(Text, Min, Max, Default, Callback)
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, 0, 0, 45)
            SliderFrame.BackgroundColor3 = Library.Theme.Secondary
            SliderFrame.Parent = Container
            Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)

            local Label = Instance.new("TextLabel")
            Label.Text = Text .. ": " .. tostring(Default)
            Label.TextColor3 = Library.Theme.Text
            Label.Size = UDim2.new(1, 0, 0, 20)
            Label.BackgroundTransparency = 1
            Label.Parent = SliderFrame

            -- Custom Slider Track Logic...
        end

        Tab.Container = Container
        table.insert(Window.Tabs, Tab)
        return Tab
    end

    -- RGB Social Links Integration
    function Window:AddSocialLink(Name, URL, IconId)
        local SocialBtn = Instance.new("TextButton")
        SocialBtn.Size = UDim2.new(1, 0, 0, 30)
        SocialBtn.Text = Name
        SocialBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SocialBtn.BackgroundColor3 = Library.Theme.Secondary
        SocialBtn.Parent = TabBar
        Instance.new("UICorner", SocialBtn).CornerRadius = UDim.new(0, 6)

        -- RGB Rainbow Effect
        task.spawn(function()
            local hue = 0
            while task.wait(0.05) do
                hue = (hue + 0.01) % 1
                SocialBtn.TextColor3 = Color3.fromHSV(hue, 1, 1)
            end
        end)

        SocialBtn.MouseButton1Click:Connect(function()
            if setclipboard then setclipboard(URL) end
        end)
    end

