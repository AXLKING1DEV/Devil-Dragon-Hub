                ValLbl.BackgroundTransparency = 1
                ValLbl.Parent = SldFrame

                local Track = Instance.new("Frame")
                Track.Size = UDim2.new(1, -20, 0, 8)
                Track.Position = UDim2.new(0, 10, 0, 28)
                Track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                Track.Parent = SldFrame

                local TrackCorner = Instance.new("UICorner", Track)
                TrackCorner.CornerRadius = UDim.new(1, 0)

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
                Fill.BackgroundColor3 = BorderColor
                Fill.Parent = Track

                local FillCorner = Instance.new("UICorner", Fill)
                FillCorner.CornerRadius = UDim.new(1, 0)

                local isDragging = false
                local function UpdateSlider(input)
                    local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    local value = math.floor(min + (max - min) * percent)
                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    ValLbl.Text = tostring(value)
                    pcall(callback, value)
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        UpdateSlider(input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSlider(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                    end
                end)
            end
            SectionObj.AddSlider = SectionObj.CreateSlider

            -- 4. CreateDropdown
            function SectionObj:CreateDropdown(drpText, options, default, callback)
                options = options or {}
                callback = callback or function() end
                local selected = default or options[1] or ""

                local DropFrame = Instance.new("Frame")
                DropFrame.Size = UDim2.new(1, 0, 0, 34)
                DropFrame.BackgroundColor3 = AXLLibrary.Themes.MainBackground
                DropFrame.ClipsDescendants = true
                DropFrame.Parent = SecContainer

                local Corner = Instance.new("UICorner", DropFrame)
                Corner.CornerRadius = UDim.new(0, 6)

                local MainBtn = Instance.new("TextButton")
                MainBtn.Size = UDim2.new(1, 0, 0, 34)
                MainBtn.BackgroundTransparency = 1
                MainBtn.Text = ""
                MainBtn.Parent = DropFrame

                local Lbl = Instance.new("TextLabel")
                Lbl.Size = UDim2.new(0.5, 0, 1, 0)
                Lbl.Position = UDim2.new(0, 10, 0, 0)
                Lbl.Font = Enum.Font.Gotham
                Lbl.Text = drpText
                Lbl.TextColor3 = AXLLibrary.Themes.TextColor
                Lbl.TextSize = 12
                Lbl.TextXAlignment = Enum.TextXAlignment.Left
                Lbl.BackgroundTransparency = 1
                Lbl.Parent = MainBtn

                local SelLbl = Instance.new("TextLabel")
                SelLbl.Size = UDim2.new(0.4, 0, 1, 0)
                SelLbl.Position = UDim2.new(0.55, -25, 0, 0)
                SelLbl.Font = Enum.Font.GothamMedium
                SelLbl.Text = selected
                SelLbl.TextColor3 = BorderColor
                SelLbl.TextSize = 12
                SelLbl.TextXAlignment = Enum.TextXAlignment.Right
                SelLbl.BackgroundTransparency = 1
                SelLbl.Parent = MainBtn

                local Arrow = Instance.new("TextLabel")
                Arrow.Size = UDim2.new(0, 20, 1, 0)
                Arrow.Position = UDim2.new(1, -22, 0, 0)
                Arrow.Font = Enum.Font.GothamBold
                Arrow.Text = "▼"
                Arrow.TextColor3 = AXLLibrary.Themes.SubTextColor
                Arrow.TextSize = 10
                Arrow.BackgroundTransparency = 1
                Arrow.Parent = MainBtn

                local OptContainer = Instance.new("Frame")
                OptContainer.Size = UDim2.new(1, -16, 0, 0)
                OptContainer.Position = UDim2.new(0, 8, 0, 36)
                OptContainer.BackgroundTransparency = 1
                OptContainer.Parent = DropFrame

                local OptLayout = Instance.new("UIListLayout", OptContainer)
                OptLayout.Padding = UDim.new(0, 4)

                local isOpen = false
                local function ToggleDrop()
                    isOpen = not isOpen
                    Arrow.Text = isOpen and "▲" or "▼"
                    local targetH = isOpen and (38 + OptLayout.AbsoluteContentSize.Y + 8) or 34
                    TweenService:Create(DropFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, 0, 0, targetH)}):Play()
                    task.delay(0.26, UpdateSecSize)
                end

                MainBtn.MouseButton1Click:Connect(ToggleDrop)

                for _, opt in ipairs(options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, 0, 0, 26)
                    OptBtn.BackgroundColor3 = AXLLibrary.Themes.ElementBackground
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.Text = opt
                    OptBtn.TextColor3 = AXLLibrary.Themes.TextColor
                    OptBtn.TextSize = 11
                    OptBtn.Parent = OptContainer

                    local OptCorner = Instance.new("UICorner", OptBtn)
                    OptCorner.CornerRadius = UDim.new(0, 4)

                    OptBtn.MouseButton1Click:Connect(function()
                        SelLbl.Text = opt
                        ToggleDrop()
                        pcall(callback, opt)
                    end)
                end
            end
            SectionObj.AddDropdown = SectionObj.CreateDropdown

            -- 5. CreateInput (TextBox)
            function SectionObj:CreateInput(inpText, placeholder, callback)
                callback = callback or function() end
                local InpFrame = Instance.new("Frame")
                InpFrame.Size = UDim2.new(1, 0, 0, 34)
                InpFrame.BackgroundColor3 = AXLLibrary.Themes.MainBackground
                InpFrame.Parent = SecContainer

                local Corner = Instance.new("UICorner", InpFrame)
                Corner.CornerRadius = UDim.new(0, 6)

                local Lbl = Instance.new("TextLabel")
                Lbl.Size = UDim2.new(0.5, 0, 1, 0)
                Lbl.Position = UDim2.new(0, 10, 0, 0)
                Lbl.Font = Enum.Font.Gotham
                Lbl.Text = inpText
                Lbl.TextColor3 = AXLLibrary.Themes.TextColor
                Lbl.TextSize = 12
                Lbl.TextXAlignment = Enum.TextXAlignment.Left
                Lbl.BackgroundTransparency = 1
                Lbl.Parent = InpFrame

                local Box = Instance.new("TextBox")
                Box.Size = UDim2.new(0.45, 0, 0, 24)
                Box.Position = UDim2.new(0.52, 0, 0.5, -12)
                Box.BackgroundColor3 = AXLLibrary.Themes.ElementBackground
                Box.Font = Enum.Font.Gotham
                Box.PlaceholderText = placeholder or "Enter..."
