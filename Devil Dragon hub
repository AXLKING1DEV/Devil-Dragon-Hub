local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- إزالة النسخة القديمة إذا وجدت لمنع التكرار
if CoreGui:FindFirstChild("AXL_LIBRARY_HUB") then
    CoreGui.AXL_LIBRARY_HUB:Destroy()
end

local Library = {}
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AXL_LIBRARY_HUB"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global

-- دالة إنشاء النوافذ الرئيسية
function Library:CreateWindow(config)
    local WindowName = config.Name or "AXL LIBRARY"
    local BgImageId = config.BackgroundImage or ""
    
    -- الواجهة الأساسية
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.5, -250, 0.5, -160)
    MainFrame.Size = UDim2.new(0, 500, 0, 320)
    MainFrame.ClipsDescendants = true

    -- حواف بنفجنية نيون
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Parent = MainFrame
    UIStroke.Color = Color3.fromRGB(138, 43, 226)
    UIStroke.Thickness = 2

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = MainFrame

    -- خلفية السكربت (تغطي كل شيء)
    if BgImageId ~= "" then
        local BGImage = Instance.new("ImageLabel")
        BGImage.Parent = MainFrame
        BGImage.BackgroundTransparency = 1
        BGImage.Size = UDim2.new(1, 0, 1, 0)
        BGImage.Image = BgImageId
        BGImage.ScaleType = Enum.ScaleType.Slice
        BGImage.ImageTransparency = 0.4
    end

    -- شريط العناوين العلوي (TopBar)
    local TopBar = Instance.new("Frame")
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    TopBar.BorderSizePixel = 0
    TopBar.Size = UDim2.new(1, 0, 0, 35)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = TopBar
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 12, 0, 0)
    TitleLabel.Size = UDim2.new(0, 200, 1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = WindowName
    TitleLabel.TextColor3 = Color3.fromRGB(200, 150, 255)
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- زر الإغلاق (X)
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    CloseBtn.Position = UDim2.new(1, -30, 0, 7)
    CloseBtn.Size = UDim2.new(0, 22, 0, 22)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 12
    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 4)
    CloseCorner.Parent = CloseBtn

    -- زر التصغير (Minimize / MinSizeButton عائم)
    local MinSizeButton = Instance.new("TextButton")
    MinSizeButton.Name = "MinSizeButton"
    MinSizeButton.Parent = ScreenGui
    MinSizeButton.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    MinSizeButton.Position = UDim2.new(0, 30, 0, 30)
    MinSizeButton.Size = UDim2.new(0, 160, 0, 40)
    MinSizeButton.Font = Enum.Font.GothamBold
    MinSizeButton.Text = "FREE LIBRARY HUB"
    MinSizeButton.TextColor3 = Color3.fromRGB(180, 100, 255)
    MinSizeButton.TextSize = 12
    MinSizeButton.Visible = false
    
    local MinStroke = Instance.new("UIStroke")
    MinStroke.Parent = MinSizeButton
    MinStroke.Color = Color3.fromRGB(138, 43, 226)
    MinStroke.Thickness = 1.5
    
    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(1, 0)
    MinCorner.Parent = MinSizeButton

    -- جعل زر الـ MinSize قابل للسحب (Draggable) للموبايل
    local dragging, dragInput, dragStart, startPos
    MinSizeButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MinSizeButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MinSizeButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- تصغير السكربت وانيميشن
    local minimized = false
    local function ToggleMinimize()
        minimized = not minimized
        if minimized then
            TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0)}):Play()
            task.wait(0.3)
            MainFrame.Visible = false
            MinSizeButton.Visible = true
        else
            MainFrame.Visible = true
            MinSizeButton.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 500, 0, 320)}):Play()
        end
    end

    -- ربط التصغير بزر إضافي أو بالنقر المزدوج
    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Parent = TopBar
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 200)
    MinimizeBtn.Position = UDim2.new(1, -60, 0, 7)
    MinimizeBtn.Size = UDim2.new(0, 22, 0, 22)
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.Text = "-"
    MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinimizeBtn.TextSize = 14
    MinimizeBtn.MouseButton1Click:Connect(ToggleMinimize)
    
    MinSizeButton.MouseButton1Click:Connect(ToggleMinimize)
    
    local MinBtnCorner = Instance.new("UICorner")
    MinBtnCorner.CornerRadius = UDim.new(0, 4)
    MinBtnCorner.Parent = MinimizeBtn

    -- حاوية الـ Tabs في اليسار
    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Parent = MainFrame
    TabContainer.Active = true
    TabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 17)
    TabContainer.BorderSizePixel = 0
    TabContainer.Position = UDim2.new(0, 0, 0, 35)
    TabContainer.Size = UDim2.new(0, 130, 1, -35)
    TabContainer.CanvasSize = UDim2.new(0, 0, 2, 0)
    TabContainer.ScrollBarThickness = 2

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Parent = TabContainer
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)

    -- حاوية الصفحات الرئيسية (Pages Container)
    local PagesContainer = Instance.new("Folder")
    PagesContainer.Parent = MainFrame

    local FirstTab = true
    local TabFunctions = {}

    function TabFunctions:AddTab(tabName, iconAsset)
        local TabButton = Instance.new("TextButton")
        TabButton.Parent = TabContainer
        TabButton.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
        TabButton.BorderSizePixel = 0
        TabButton.Size = UDim2.new(1, 0, 0, 35)
        TabButton.Font = Enum.Font.GothamSemibold
        TabButton.Text = "  " .. tabName
        TabButton.TextColor3 = Color3.fromRGB(170, 170, 170)
        TabButton.TextSize = 12
        TabButton.TextXAlignment = Enum.TextXAlignment.Left

        -- دعم أيقونات الـ rbxassetid أو الـ URL
        if iconAsset and iconAsset ~= "" then
            local Icon = Instance.new("ImageLabel")
            Icon.Parent = TabButton
            Icon.BackgroundTransparency = 1
            Icon.Position = UDim2.new(0, 8, 0.5, -10)
            Icon.Size = UDim2.new(0, 20, 0, 20)
            Icon.Image = iconAsset
            TabButton.Text = "      " .. tabName
        end

        local Page = Instance.new("ScrollingFrame")
        Page.Parent = PagesContainer
        Page.Active = true
        Page.BackgroundTransparency = 1
        Page.Position = UDim2.new(0, 140, 0, 45)
        Page.Size = UDim2.new(1, -150, 1, -55)
        Page.CanvasSize = UDim2.new(0, 0, 3, 0)
        Page.ScrollBarThickness = 3
        Page.Visible = false

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Parent = Page
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 8)

        if FirstTab then
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(200, 130, 255)
            FirstTab = false
        end

        TabButton.MouseButton1Click:Connect(function()
            for _, p in pairs(PagesContainer:GetChildren()) do
                p.Visible = false
            end
            for _, b in pairs(TabContainer:GetChildren()) do
                if b:IsA("TextButton") then
                    b.TextColor3 = Color3.fromRGB(170, 170, 170)
                end
            end
            Page.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(200, 130, 255)
        end)

        local ElementHandler = {}

        -- 1. زر عادي (Button)
        function ElementHandler:AddButton(btnText, callback)
            local Button = Instance.new("TextButton")
            Button.Parent = Page
            Button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            Button.Size = UDim2.new(1, -10, 0, 35)
            Button.Font = Enum.Font.GothamMedium
            Button.Text = btnText
            Button.TextColor3 = Color3.fromRGB(230, 230, 230)
            Button.TextSize = 12

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 6)
            BtnCorner.Parent = Button

            Button.MouseButton1Click:Connect(function()
                -- انيميشن خفيف للضغط
                TweenService:Create(Button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play()
                task.wait(0.1)
                TweenService:Create(Button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(25, 25, 35)}):Play()
                pcall(callback)
            end)
        end

        -- 2. زر التبديل (Toggle)
        function ElementHandler:AddToggle(toggleText, default, callback)
            local toggled = default or false
            
            local ToggleFrame = Instance.new("TextButton")
            ToggleFrame.Parent = Page
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            ToggleFrame.Size = UDim2.new(1, -10, 0, 35)
            ToggleFrame.AutoButtonColor = false
            ToggleFrame.Text = ""

            local TFCorner = Instance.new("UICorner")
            TFCorner.CornerRadius = UDim.new(0, 6)
            TFCorner.Parent = ToggleFrame

            local Label = Instance.new("TextLabel")
            Label.Parent = ToggleFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Size = UDim2.new(0, 250, 1, 0)
            Label.Font = Enum.Font.GothamMedium
            Label.Text = toggleText
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.TextSize = 12
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Switch = Instance.new("Frame")
            Switch.Parent = ToggleFrame
            Switch.BackgroundColor3 = toggled and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(40, 40, 50)
            Switch.Position = UDim2.new(1, -45, 0.5, -10)
            Switch.Size = UDim2.new(0, 35, 0, 20)

            local SwitchCorner = Instance.new("UICorner")
            SwitchCorner.CornerRadius = UDim.new(1, 0)
            SwitchCorner.Parent = Switch

            ToggleFrame.MouseButton1Click:Connect(function()
                toggled = not toggled
                Switch.BackgroundColor3 = toggled and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(40, 40, 50)
                pcall(callback, toggled)
            end)
        end

        -- 3. سلايدر (Slider - شبيه بريدز ودقيق باللمس والماوس)
        function ElementHandler:AddSlider(sliderText, min, max, default, callback)
            local SliderVal = default or min
            
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Parent = Page
            SliderFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            SliderFrame.Size = UDim2.new(1, -10, 0, 50)

            local SFCorner = Instance.new("UICorner")
            SFCorner.CornerRadius = UDim.new(0, 6)
            SFCorner.Parent = SliderFrame

            local Label = Instance.new("TextLabel")
            Label.Parent = SliderFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 10, 0, 5)
            Label.Size = UDim2.new(1, -20, 0, 20)
            Label.Font = Enum.Font.GothamMedium
            Label.Text = sliderText .. ": " .. SliderVal
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.TextSize = 12
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local SliderBar = Instance.new("Frame")
            SliderBar.Parent = SliderFrame
            SliderBar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            SliderBar.Position = UDim2.new(0, 10, 0, 32)
            SliderBar.Size = UDim2.new(1, -20, 0, 6)

            local SBCorner = Instance.new("UICorner")
            SBCorner.CornerRadius = UDim.new(1, 0)
            SBCorner.Parent = SliderBar

            local Fill = Instance.new("Frame")
            Fill.Parent = SliderBar
            Fill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
            Fill.Size = UDim2.new((SliderVal - min) / (max - min), 0, 1, 0)

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            local draggingSlider = false
            local function UpdateSlider(input)
                local pos = UDim2.new(math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1), 0, 1, 0)
                Fill.Size = pos
                local val = math.floor(min + ((max - min) * pos.X.Scale))
                SliderVal = val
                Label.Text = sliderText .. ": " .. SliderVal
                pcall(callback, SliderVal)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)
        end

        return ElementHandler
    end

    return TabFunctions
end

return Library
