            SectionObj.AddSocialLink = SectionObj.CreateSocialButton

            -- 7. CreateLabel & Paragraph
            function SectionObj:CreateLabel(text)
                local Lbl = Instance.new("TextLabel")
                Lbl.Size = UDim2.new(1, 0, 0, 22)
