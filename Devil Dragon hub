            LinkCorner.CornerRadius = UDim.new(0, 6)
            LinkCorner.Parent = LinkBtn

            local LinkStroke = Instance.new("UIStroke")
            LinkStroke.Color = AccentColor
            LinkStroke.Thickness = 1
            LinkStroke.Parent = LinkBtn

            local LinkText = Instance.new("TextLabel")
            LinkText.Size = UDim2.new(1, 0, 1, 0)
            LinkText.BackgroundTransparency = 1
            LinkText.Text = "[" .. platform .. "] " .. name .. " (Click to Copy)"
            LinkText.TextColor3 = Color3.fromRGB(255, 255, 255)
            LinkText.Font = Enum.Font.GothamMedium
            LinkText.TextSize = 12
            LinkText.ZIndex = 4
            LinkText.Parent = LinkBtn

            LinkBtn.MouseButton1Click:Connect(function()
                if setclipboard then
                    setclipboard(url)
                    LinkText.Text = "COPIED TO CLIPBOARD!"
                    task.wait(1.5)
                    LinkText.Text = "[" .. platform .. "] " .. name .. " (Click to Copy)"
                else
                    LinkText.Text = "Clipboard not supported!"
                end
            end)
        end

        table.insert(Window.Tabs, TabElements)
        return TabElements
    end

    return Window
end

return AXLLibrary
