-- Image Handler Utility (Supports rbxassetid & URL Web Images)
local function GetImageAsset(img)
    if not img or img == "" then return "" end
    if type(img) == "number" or string.sub(tostring(img), 1, 12) == "rbxassetid://" then
        return type(img) == "number" and "rbxassetid://" .. tostring(img) or img
    end
    if string.sub(tostring(img), 1, 4) == "http" then
        if getcustomasset and writefile then
            local fileName = "AXL_Cache_" .. string.sub(game:GetService("HttpService"):GenerateGUID(false), 1, 8) .. ".png"
            pcall(function()
                writefile(fileName, game:HttpGet(img))
            end)
            if isfile and isfile(fileName) then
                return getcustomasset(fileName)
            end
        end
        return img
    end
    return img
end

-- Universal Clipboard Function
local function CopyToClipboard(txt)
    if setclipboard then
        setclipboard(txt)
    elseif toclipboard then
        toclipboard(txt)
    end
end

-- Universal Touch & Mouse Drag Function
local function MakeDraggable(guiFrame, handle)
    handle = handle or guiFrame
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        guiFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

