                Label.Text = text
                Label.TextColor3 = CustomTheme.Text
                Label.Font = Enum.Font.GothamMedium
                Label.TextSize = 13
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.Parent = InputFrame

                local TextBox = Instance.new("TextBox")
                TextBox.Size = UDim2.new(0.45, 0, 0.7, 0)
                TextBox.Position = UDim2.new(0.52, 0, 0.15, 0)
                TextBox.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                TextBox.PlaceholderText = placeholder or "Enter..."
                TextBox.Text = ""
                TextBox.TextColor3 = CustomTheme.Text
                TextBox.Font = Enum.Font.Gotham
                TextBox.TextSize = 12
                TextBox.Parent = InputFrame

                local BoxCorner = Instance.new("UICorner")
                BoxCorner.CornerRadius = UDim.new(0, 4)
                BoxCorner.Parent = TextBox

                TextBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed then
                        pcall(callback, TextBox.Text)
                    end
                end)
            end

            -- 6. Social Buttons (Telegram, YouTube, Discord - Auto Copy)
            function ElementAPI:CreateSocial(platformType, link)
                local Colors = {
                    Discord = Color3.fromRGB(88, 101, 242),
                    Telegram = Color3.fromRGB(0, 136, 204),
                    YouTube = Color3.fromRGB(255, 0, 0)
                }
                local platformColor = Colors[platformType] or CustomTheme.Accent

                local SocBtn = Instance.new("TextButton")
                SocBtn.Size = UDim2.new(1, -5, 0, 34)
                SocBtn.BackgroundColor3 = CustomTheme.ElementBg
                SocBtn.Text = platformType .. ": " .. link .. " [Click to Copy]"
                SocBtn.TextColor3 = platformColor
                SocBtn.Font = Enum.Font.GothamBold
                SocBtn.TextSize = 12
                SocBtn.Parent = TabContent

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 6)
                Corner.Parent = SocBtn

                SocBtn.MouseButton1Click:Connect(function()
                    SetClipboard(link)
                    SocBtn.Text = "Copied link to clipboard!"
                    task.wait(1.5)
                    SocBtn.Text = platformType .. ": " .. link .. " [Click to Copy]"
                end)
            end

            return ElementAPI
        end

        return TabAPI
    end

    return WindowAPI
end

return AXL
