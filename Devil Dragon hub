-- Utility Functions
local function MakeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle = handle or frame

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

local function SetClipboard(text)
    if setclipboard then
        setclipboard(tostring(text))
    end
end

-- Image Handler (Supports rbxassetid:// & HTTP URLs)
local function ProcessImage(imgStr)
    if not imgStr or imgStr == "" then return "" end
    if string.find(imgStr, "http") then
        return imgStr -- Handles custom URL renderer if supported by executor
    elseif not string.find(imgStr, "rbxassetid://") then
        return "rbxassetid://" .. tostring(imgStr)
    end
    return imgStr
end

