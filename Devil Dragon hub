-- Optimized for Smoothness, Dragging, Image Handling, and Custom Features

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Library = {}
Library.Theme = {
    Primary = Color3.fromRGB(25, 25, 35),
    Secondary = Color3.fromRGB(35, 35, 50),
    Accent = Color3.fromRGB(0, 170, 255),
    Text = Color3.fromRGB(255, 255, 255),
    RGB = false
}

-- Helper function to apply Images (URL or RBX ID)
local function SetImage(ImageLabel, ImageId)
    if not ImageId or ImageId == "" then return end
    if string.sub(ImageId, 1, 4) == "http" then
        -- Custom Image handling via writefile/getgenv if executor supports custom assets
        if getcustomasset then
            local fileName = "temp_img_" .. tostring(math.random(1000, 9999)) .. ".png"
            writefile(fileName, game:HttpGet(ImageId))
            ImageLabel.Image = getcustomasset(fileName)
        end
    elseif string.find(ImageId, "rbxassetid://") or tonumber(ImageId) then
        ImageLabel.Image = tonumber(ImageId) and ("rbxassetid://" .. ImageId) or ImageId
    end
end

-- Smooth Dragging System
local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(gui, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

