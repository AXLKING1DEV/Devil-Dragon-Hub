-- Image Parser Engine (Supports RBX ID, HTTP URLs, getcustomasset)
local function GetImage(imageStr)
    if not imageStr or imageStr == "" then return "" end
    if string.sub(imageStr, 1, 4) == "http" then
        if getcustomasset and writefile and isfile then
            local fileHash = "axl_cache_" .. string.gsub(imageStr, "%W", "") .. ".png"
            if not isfile(fileHash) then
                pcall(function()
                    writefile(fileHash, game:HttpGet(imageStr))
                end)
            end
            if isfile(fileHash) then
                return getcustomasset(fileHash)
            end
        end
        return imageStr
    elseif not string.find(imageStr, "rbxassetid://") then
        return "rbxassetid://" .. tostring(imageStr)
    end
    return imageStr
end

-- Universal Mouse & Touch Drag Engine
local function EnableDrag(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle = handle or frame

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(frame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

-- Copy to Clipboard Helper
local function CopyText(text)
    if setclipboard then
        setclipboard(tostring(text))
    end
end

